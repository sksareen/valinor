# Copy to .env (gitignored). Never commit real keys or absolute home paths.

OPENROUTER_API_KEY=

# Bind address for server.js (default loopback-only)
# VALINOR_BIND=127.0.0.1
# VALINOR_BIND=0.0.0.0

# HTTP port (default 4777). Run a second copy with e.g. PORT=4780.
# PORT=4777

# User data home for NEW state files (default ~/.valinor). Existing repo-local
# stores keep working where they are (backward compat); only new writes go here,
# so `git pull` never touches user data. See README "User data & updating".
# VALINOR_DATA_DIR=

# Optional — MESSAGES / CRM (soft-fail empty when unset).
# Val's Live people tools (lookup_person) need NETWORK_DB_PATH — no machine default in source.
# NETWORK_DB_PATH=
# NETWORK_PEOPLE_DIR=
# CHAT_DB_PATH=

# Optional — Loopkeeper override (Valinor spawns ./loopkeeper on :18003 by default)
# LOOPKEEPER_URL=http://127.0.0.1:18003

# Optional — Valinor Live memory + ingest/execute stores (data-home defaults;
# no absolute paths in source)
# VALINOR_MEMORY_PATH=        # default: <data-home>/valinor.md
# INGEST_DIR=                 # default: <data-home>/ingest
# EXECUTE_DIR=                # default: <data-home>/execute

# Optional — Live voice brain (OpenRouter slug). Default is meta/muse-spark-1.3.
# LIVE_MODEL=openai/gpt-4.1
# Live fallback if the primary is ever gated at inference (403/age-gate): default openai/gpt-4.1.
# LIVE_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Optional — Live lookup (sunset/weather/news). If set, Val prefers Exa over DuckDuckGo.
# EXA_API_KEY=

# Optional — Rehearse mock interview partner (defaults work out of the box)
# REHEARSE_MODEL=meta/muse-spark-1.3
# REHEARSE_FALLBACK_MODEL=anthropic/claude-opus-4.7
# REHEARSE_TTS_MODEL=google/gemini-3.1-flash-tts-preview
# REHEARSE_TTS_FALLBACK_MODEL=x-ai/grok-voice-tts-1.0
# REHEARSE_TTS_VOICE=Charon
# REHEARSE_TTS_FALLBACK_VOICE=Rex
# REHEARSE_TTS_FORMAT=mp3
# Persona config path (default search: ./rehearse.config.json, then built-ins).
# Copy rehearse.config.example.json to rehearse.config.json and edit that instead.
# REHEARSE_CONFIG=

# Optional — per-store path overrides (each wins over repo-local + data home)
# BOARD_NOTES_PATH=
# DRAFTS_PATH=
# CRM_PATH=
# MESSAGE_PROFILE_PATH=
# LIVE_SESSION_PATH=
# LIVE_CONVOS_PATH=
# AGENT_USAGE_PATH=
# REHEARSE_SESSION_PATH=
# LETTERS_DIR=
# LETTER_HISTORY_DIR=
# LETTER_PROMPT_RUNS_PATH=
# WRITING_PROFILE_PATH=
# WRITING_STARS_PATH=
# WRITING_SAMPLES_PATH=
# WRITING_RUNS_PATH=
# WRITING_PROJECTS_PATH=
# LIVE_PROMPT_SYSTEM_PATH=
# LIVE_PROMPT_VERSIONS_PATH=
# KITTEN_TTS_CACHE_DIR=
# KITTEN_TTS_TMP_DIR=
