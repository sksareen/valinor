# Copy to .env (gitignored). Never commit real keys or absolute home paths.

OPENROUTER_API_KEY=

# Bind address for server.js (default loopback-only)
# VALINOR_BIND=127.0.0.1
# VALINOR_BIND=0.0.0.0

# Optional — MESSAGES / CRM (soft-fail empty when unset).
# Val's Live people tools (lookup_person) need NETWORK_DB_PATH — no machine default in source.
# NETWORK_DB_PATH=
# NETWORK_PEOPLE_DIR=
# CHAT_DB_PATH=

# Optional — Loopkeeper override (Valinor spawns ./loopkeeper on :18003 by default)
# LOOPKEEPER_URL=http://127.0.0.1:18003

# Optional — personal vault + Valinor Live memory (homedir defaults; no absolute paths in source)
# SAVAR_VAULT=                # default: ~/Savar
# VALINOR_MEMORY_PATH=        # default: ~/Savar/memory/valinor.md
# INGEST_DIR=                 # default: ~/Savar/memory/ingest

# Optional — Live voice brain (OpenRouter slug). Default is meta/muse-spark-1.3.
# LIVE_MODEL=openai/gpt-4.1
# Live fallback if the primary is ever gated at inference (403/age-gate): default openai/gpt-4.1.
# LIVE_FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# Optional — Live lookup (sunset/weather/news). If set, Val prefers Exa over DuckDuckGo.
# EXA_API_KEY=

# Optional — Rehearse mock interview partner (defaults work out of the box)
# REHEARSE_MODEL=meta/muse-spark-1.3
# REHEARSE_FALLBACK_MODEL=anthropic/claude-opus-4.7
# REHEARSE_TTS_MODEL=google/gemini-3.1-flash-tts-preview
# REHEARSE_TTS_FALLBACK_MODEL=x-ai/grok-voice-tts-1.0
# REHEARSE_TTS_VOICE=Charon
# REHEARSE_TTS_FALLBACK_VOICE=Rex
# REHEARSE_TTS_FORMAT=mp3
