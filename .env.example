# Copy to .env (gitignored). Never commit real keys or absolute home paths.

OPENROUTER_API_KEY=

# Bind address for server.js (default loopback-only)
# VALINOR_BIND=127.0.0.1
# VALINOR_BIND=0.0.0.0

# Optional — MESSAGES / CRM (soft-fail empty when unset)
# NETWORK_DB_PATH=
# NETWORK_PEOPLE_DIR=
# CHAT_DB_PATH=

# Optional — Loopkeeper override (Valinor spawns ./loopkeeper on :18003 by default)
# LOOPKEEPER_URL=http://127.0.0.1:18003
